# SignalFlow environment example
# Phase 0 runs with no secrets. These keys are placeholders for later phases.
# The application renders fully without any of these values.

# Database (Phase 1+, Prisma + PostgreSQL)
DATABASE_URL="postgresql://user:password@localhost:5432/signalflow"

# Authentication (Phase 1+, Clerk)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""

# AI providers (Phase 2+, not called in Phase 0)
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GOOGLE_GEMINI_API_KEY=""

# Communication providers (Phase 2+, not called in Phase 0)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
SENDGRID_API_KEY=""
ELEVENLABS_API_KEY=""

# Demo mode flag. Phase 0 is always demo mode.
NEXT_PUBLIC_DEMO_MODE="true"
