# SignalFlow environment example
# Copy this file to .env for local development. The .env file is gitignored.
# Only DATABASE_URL is required in Phase 1. The other values are placeholders
# for later phases and are not used by the running application yet.

# Database (required in Phase 1, Prisma + PostgreSQL)
# This local development value is a convenience, not a secret.
DATABASE_URL="postgresql://signalflow:signalflow@127.0.0.1:5432/signalflow?schema=public"

# Authentication (Clerk, optional). When both are set, Clerk protects the app
# routes and resolves the session. When unset, the app runs in a clearly
# labeled demo auth context and stays fully reviewable.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""

# AI providers (Phase 3, not called yet)
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GOOGLE_GEMINI_API_KEY=""

# Communication providers (Phase 3, not called yet)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
SENDGRID_API_KEY=""
ELEVENLABS_API_KEY=""

# Demo mode flag. The application is always demo mode through Phase 1.
NEXT_PUBLIC_DEMO_MODE="true"
