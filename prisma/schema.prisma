// SignalFlow Prisma schema (Phase 1).
// PostgreSQL is the source of truth. The application reads through a
// repository and service layer. No live integrations or secrets are used.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Channel {
  sms
  email
  voice
  human
}

enum ConsentState {
  granted
  denied
  unknown
  revoked
}

enum SignalType {
  new_lead
  missed_call
  appointment_cancellation
  email_engagement
  recall_opportunity
  estimate_request
  service_due
  consultation_request
}

enum SignalSource {
  web_form
  phone
  email
  chat
  third_party
  scheduler
}

enum SignalPriority {
  critical
  high
  medium
  low
}

enum OpportunityStage {
  new
  contact_attempted
  engaged
  appointment_set
  needs_human_review
  won
  lost
  dormant
  reactivated
}

enum CommunicationStatus {
  drafted
  queued
  sent
  delivered
  replied
  failed
  blocked
  escalated
}

enum AuditEventType {
  SIGNAL_RECEIVED
  INTENT_CLASSIFIED
  OPPORTUNITY_CREATED
  POLICY_ALLOWED_ACTION
  POLICY_BLOCKED_ACTION
  MESSAGE_DRAFTED
  VOICE_CALL_QUEUED
  HUMAN_TASK_CREATED
  CUSTOMER_OPTED_OUT
}

enum AuditOutcome {
  allowed
  blocked
  review
  recorded
}

enum PolicyDecisionType {
  allowed
  blocked
  needs_review
}

enum ComplianceSensitivity {
  standard
  elevated
  high
}

enum PackPhaseStatus {
  mvp_focus
  in_design
  planned
  research
}

enum RiskSeverity {
  info
  warning
  critical
}

model VerticalPack {
  id          String                @id
  name        String
  summary     String
  keySignals  String[]
  keyActions  String[]
  sensitivity ComplianceSensitivity
  phaseStatus PackPhaseStatus
  customers   Customer[]
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
}

model Customer {
  id               String           @id @default(cuid())
  name             String
  verticalId       String
  vertical         VerticalPack     @relation(fields: [verticalId], references: [id])
  preferredChannel Channel
  optedOut         Boolean          @default(false)
  lastAction       String?
  lastActionAt     DateTime?
  contactMethods   ContactMethod[]
  consentRecords   ConsentRecord[]
  riskFlags        RiskFlag[]
  signals          Signal[]
  opportunities    Opportunity[]
  communications   Communication[]
  auditEvents      AuditEvent[]
  policyDecisions  PolicyDecision[]
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([verticalId])
}

model ContactMethod {
  id         String       @id @default(cuid())
  customerId String
  customer   Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  channel    Channel
  value      String
  consent    ConsentState @default(unknown)

  @@unique([customerId, channel])
}

model ConsentRecord {
  id         String       @id @default(cuid())
  customerId String
  customer   Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  channel    Channel
  state      ConsentState
  source     String
  capturedAt DateTime?
  createdAt  DateTime     @default(now())

  @@index([customerId])
}

model Signal {
  id                 String           @id @default(cuid())
  type               SignalType
  label              String
  customerId         String
  customer           Customer         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  source             SignalSource
  priority           SignalPriority
  recommendedAction  String
  recommendedChannel Channel
  consentStatus      ConsentState
  detail             String
  opportunity        Opportunity?     @relation(fields: [opportunityId], references: [id])
  opportunityId      String?
  communications     Communication[]
  auditEvents        AuditEvent[]
  policyDecisions    PolicyDecision[]
  receivedAt         DateTime         @default(now())

  @@index([customerId])
  @@index([opportunityId])
}

model Opportunity {
  id             String           @id @default(cuid())
  title          String
  customerId     String
  customer       Customer         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  stage          OpportunityStage
  intentScore    Int
  estimatedValue Int
  owner          String
  signals        Signal[]
  communications Communication[]
  auditEvents    AuditEvent[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([customerId])
  @@index([stage])
}

model Communication {
  id            String              @id @default(cuid())
  channel       Channel
  customerId    String
  customer      Customer            @relation(fields: [customerId], references: [id], onDelete: Cascade)
  opportunityId String?
  opportunity   Opportunity?        @relation(fields: [opportunityId], references: [id])
  signalId      String?
  signal        Signal?             @relation(fields: [signalId], references: [id])
  subject       String
  preview       String
  status        CommunicationStatus
  simulated     Boolean             @default(true)
  createdAt     DateTime            @default(now())

  @@index([customerId])
  @@index([channel])
}

model AuditEvent {
  id             String         @id @default(cuid())
  type           AuditEventType
  customerId     String
  customer       Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  signalId       String?
  signal         Signal?        @relation(fields: [signalId], references: [id])
  opportunityId  String?
  opportunity    Opportunity?   @relation(fields: [opportunityId], references: [id])
  policyDecision String
  action         String
  outcome        AuditOutcome
  occurredAt     DateTime       @default(now())

  @@index([customerId])
  @@index([occurredAt])
}

model PolicyDecision {
  id          String             @id @default(cuid())
  customerId  String
  customer    Customer           @relation(fields: [customerId], references: [id], onDelete: Cascade)
  signalId    String?
  signal      Signal?            @relation(fields: [signalId], references: [id])
  channel     Channel
  decision    PolicyDecisionType
  reason      String
  explanation String
  createdAt   DateTime           @default(now())

  @@index([customerId])
}

model RiskFlag {
  id         String       @id @default(cuid())
  customerId String
  customer   Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  label      String
  severity   RiskSeverity

  @@index([customerId])
}
