// SignalFlow Prisma schema (Phase 1).
// PostgreSQL is the source of truth. The application reads through a
// repository and service layer. No live integrations or secrets are used.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Channel {
  sms
  email
  voice
  human
}

enum ConsentState {
  granted
  denied
  unknown
  revoked
}

enum SignalType {
  new_lead
  missed_call
  appointment_cancellation
  email_engagement
  recall_opportunity
  estimate_request
  service_due
  consultation_request
}

enum SignalSource {
  web_form
  phone
  email
  chat
  third_party
  scheduler
}

enum SignalPriority {
  critical
  high
  medium
  low
}

enum OpportunityStage {
  new
  contact_attempted
  engaged
  appointment_set
  needs_human_review
  won
  lost
  dormant
  reactivated
}

enum CommunicationStatus {
  drafted
  queued
  sent
  delivered
  replied
  failed
  blocked
  escalated
}

enum AuditEventType {
  SIGNAL_RECEIVED
  INTENT_CLASSIFIED
  OPPORTUNITY_CREATED
  POLICY_ALLOWED_ACTION
  POLICY_BLOCKED_ACTION
  MESSAGE_DRAFTED
  VOICE_CALL_QUEUED
  HUMAN_TASK_CREATED
  CUSTOMER_OPTED_OUT
  WORKFLOW_CREATED
  WORKFLOW_STARTED
  ACTION_ALLOWED
  ACTION_BLOCKED
  ACTION_EXECUTED
  ESCALATION_CREATED
  WORKFLOW_COMPLETED
  OUTCOME_EVENT_CREATED
  STAGE_TRANSITION_CREATED
  REVENUE_ATTRIBUTED
  MISSED_OPPORTUNITY_ESTIMATED
  WORKFLOW_EFFECTIVENESS_SCORED
  USER_CONTEXT_RESOLVED
  ORGANIZATION_CONTEXT_RESOLVED
  AUTHORIZATION_CHECK_PASSED
  AUTHORIZATION_CHECK_FAILED
  ROLE_ASSIGNED
  MEMBERSHIP_CREATED
  AI_RECOMMENDATION_CREATED
  AI_RECOMMENDATION_APPROVED
  AI_RECOMMENDATION_REJECTED
  AI_EXPLANATION_GENERATED
  AI_REVIEW_REQUIRED
  AI_REVIEW_COMPLETED
}

enum AIRecommendationStatus {
  draft
  generated
  pending_review
  approved
  rejected
  executed
  archived
}

enum AIReviewState {
  pending_review
  approved
  rejected
  needs_revision
  escalated
}

enum AIReviewDecisionType {
  approved
  rejected
  needs_revision
  escalated
}

enum OutcomeEventType {
  CUSTOMER_REPLIED
  EMAIL_OPENED
  APPOINTMENT_SCHEDULED
  APPOINTMENT_CONFIRMED
  HUMAN_TASK_CREATED
  HUMAN_HANDOFF_COMPLETED
  OPPORTUNITY_ADVANCED
  OPPORTUNITY_WON
  OPPORTUNITY_LOST
  OPPORTUNITY_DORMANT
  OPPORTUNITY_REACTIVATED
  NO_RESPONSE
  ACTION_BLOCKED
  COMPLIANCE_STOP
}

enum AttributionType {
  INFLUENCED
  ASSISTED
  RECOVERED
  PREVENTED_LOSS
  MISSED
}

enum MissedOpportunitySeverity {
  low
  medium
  high
  critical
}

enum Role {
  OWNER
  ADMIN
  MANAGER
  SALES_USER
  SERVICE_USER
  MARKETING_USER
  COMPLIANCE_REVIEWER
  VIEWER
}

enum MembershipStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

enum WorkflowOutcomeType {
  completed
  partially_completed
  blocked
  escalated
  paused
  failed_validation
}

enum ActionTypeEnum {
  SEND_SMS
  SEND_EMAIL
  PLACE_VOICE_CALL
  CREATE_TASK
  ASSIGN_OWNER
  BOOK_APPOINTMENT
  ESCALATE_MANAGER
  REVIEW_OPPORTUNITY
  PAUSE_OUTREACH
  CLOSE_OPPORTUNITY
}

enum WorkflowActionStatus {
  planned
  executed
  blocked
  skipped
  escalated
}

enum AuditOutcome {
  allowed
  blocked
  review
  recorded
}

enum PolicyDecisionType {
  allowed
  blocked
  needs_review
}

enum ComplianceSensitivity {
  standard
  elevated
  high
}

enum PackPhaseStatus {
  mvp_focus
  in_design
  planned
  research
}

enum RiskSeverity {
  info
  warning
  critical
}

model Organization {
  id                     String                          @id @default(cuid())
  name                   String
  slug                   String                          @unique
  industry               String
  memberships            Membership[]
  customers              Customer[]
  contactMethods         ContactMethod[]
  consentRecords         ConsentRecord[]
  signals                Signal[]
  opportunities          Opportunity[]
  communications         Communication[]
  auditEvents            AuditEvent[]
  policyDecisions        PolicyDecision[]
  riskFlags              RiskFlag[]
  workflowRuns           WorkflowRun[]
  workflowActions        WorkflowAction[]
  workflowResults        WorkflowResult[]
  outcomeEvents          OutcomeEvent[]
  attributions           RevenueAttribution[]
  stageTransitions       StageTransition[]
  effectivenessSnapshots WorkflowEffectivenessSnapshot[]
  missedOpportunities    MissedOpportunityEstimate[]
  aiRecommendations      AIRecommendation[]
  aiExplanations         AIExplanation[]
  aiReviewDecisions      AIReviewDecision[]
  createdAt              DateTime                        @default(now())
  updatedAt              DateTime                        @updatedAt
}

model User {
  id          String       @id @default(cuid())
  clerkUserId String?      @unique
  email       String       @unique
  name        String
  memberships Membership[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Membership {
  id             String           @id @default(cuid())
  userId         String
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role           Role
  status         MembershipStatus @default(ACTIVE)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@unique([userId, organizationId])
  @@index([organizationId])
}

model VerticalPack {
  id          String                @id
  name        String
  summary     String
  keySignals  String[]
  keyActions  String[]
  sensitivity ComplianceSensitivity
  phaseStatus PackPhaseStatus
  customers   Customer[]
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
}

model Customer {
  id                  String                      @id @default(cuid())
  organizationId      String
  organization        Organization                @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name                String
  verticalId          String
  vertical            VerticalPack                @relation(fields: [verticalId], references: [id])
  preferredChannel    Channel
  optedOut            Boolean                     @default(false)
  lastAction          String?
  lastActionAt        DateTime?
  contactMethods      ContactMethod[]
  consentRecords      ConsentRecord[]
  riskFlags           RiskFlag[]
  signals             Signal[]
  opportunities       Opportunity[]
  communications      Communication[]
  auditEvents         AuditEvent[]
  policyDecisions     PolicyDecision[]
  workflowRuns        WorkflowRun[]
  outcomeEvents       OutcomeEvent[]
  attributions        RevenueAttribution[]
  missedOpportunities MissedOpportunityEstimate[]
  aiRecommendations   AIRecommendation[]
  createdAt           DateTime                    @default(now())
  updatedAt           DateTime                    @updatedAt

  @@index([verticalId])
  @@index([organizationId])
}

model ContactMethod {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customerId     String
  customer       Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  channel        Channel
  value          String
  consent        ConsentState @default(unknown)

  @@unique([customerId, channel])
  @@index([organizationId])
}

model ConsentRecord {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customerId     String
  customer       Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  channel        Channel
  state          ConsentState
  source         String
  capturedAt     DateTime?
  createdAt      DateTime     @default(now())

  @@index([customerId])
  @@index([organizationId])
}

model Signal {
  id                 String           @id @default(cuid())
  organizationId     String
  organization       Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  type               SignalType
  label              String
  customerId         String
  customer           Customer         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  source             SignalSource
  priority           SignalPriority
  recommendedAction  String
  recommendedChannel Channel
  consentStatus      ConsentState
  detail             String
  opportunity        Opportunity?     @relation(fields: [opportunityId], references: [id])
  opportunityId      String?
  communications     Communication[]
  auditEvents        AuditEvent[]
  policyDecisions    PolicyDecision[]
  receivedAt         DateTime         @default(now())

  @@index([customerId])
  @@index([opportunityId])
  @@index([organizationId])
}

model Opportunity {
  id                  String                      @id @default(cuid())
  organizationId      String
  organization        Organization                @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  title               String
  customerId          String
  customer            Customer                    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  stage               OpportunityStage
  intentScore         Int
  estimatedValue      Int
  owner               String
  signals             Signal[]
  communications      Communication[]
  auditEvents         AuditEvent[]
  workflowRuns        WorkflowRun[]
  outcomeEvents       OutcomeEvent[]
  attributions        RevenueAttribution[]
  stageTransitions    StageTransition[]
  missedOpportunities MissedOpportunityEstimate[]
  aiRecommendations   AIRecommendation[]
  createdAt           DateTime                    @default(now())
  updatedAt           DateTime                    @updatedAt

  @@index([customerId])
  @@index([stage])
  @@index([organizationId])
}

model Communication {
  id             String              @id @default(cuid())
  organizationId String
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  channel        Channel
  customerId     String
  customer       Customer            @relation(fields: [customerId], references: [id], onDelete: Cascade)
  opportunityId  String?
  opportunity    Opportunity?        @relation(fields: [opportunityId], references: [id])
  signalId       String?
  signal         Signal?             @relation(fields: [signalId], references: [id])
  subject        String
  preview        String
  status         CommunicationStatus
  simulated      Boolean             @default(true)
  createdAt      DateTime            @default(now())

  @@index([customerId])
  @@index([channel])
  @@index([organizationId])
}

model AuditEvent {
  id             String         @id @default(cuid())
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  type           AuditEventType
  customerId     String?
  customer       Customer?      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  signalId       String?
  signal         Signal?        @relation(fields: [signalId], references: [id])
  opportunityId  String?
  opportunity    Opportunity?   @relation(fields: [opportunityId], references: [id])
  workflowRunId  String?
  workflowRun    WorkflowRun?   @relation(fields: [workflowRunId], references: [id], onDelete: Cascade)
  policyDecision String
  action         String
  outcome        AuditOutcome
  occurredAt     DateTime       @default(now())

  @@index([customerId])
  @@index([occurredAt])
  @@index([workflowRunId])
  @@index([organizationId])
}

model PolicyDecision {
  id             String             @id @default(cuid())
  organizationId String
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customerId     String
  customer       Customer           @relation(fields: [customerId], references: [id], onDelete: Cascade)
  signalId       String?
  signal         Signal?            @relation(fields: [signalId], references: [id])
  channel        Channel
  decision       PolicyDecisionType
  reason         String
  explanation    String
  createdAt      DateTime           @default(now())

  @@index([customerId])
  @@index([organizationId])
}

model RiskFlag {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customerId     String
  customer       Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  label          String
  severity       RiskSeverity

  @@index([customerId])
  @@index([organizationId])
}

model WorkflowRun {
  id               String                         @id @default(cuid())
  organizationId   String
  organization     Organization                   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customerId       String
  customer         Customer                       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  opportunityId    String?
  opportunity      Opportunity?                   @relation(fields: [opportunityId], references: [id])
  title            String
  trigger          String
  intentScore      Int
  opportunityScore Int
  engagementScore  Int
  outcome          WorkflowOutcomeType
  actionsExecuted  Int                            @default(0)
  actionsBlocked   Int                            @default(0)
  actionsEscalated Int                            @default(0)
  actions          WorkflowAction[]
  result           WorkflowResult?
  auditEvents      AuditEvent[]
  outcomeEvents    OutcomeEvent[]
  attributions     RevenueAttribution[]
  effectiveness    WorkflowEffectivenessSnapshot?
  createdAt        DateTime                       @default(now())

  @@index([customerId])
  @@index([outcome])
  @@index([organizationId])
}

model WorkflowAction {
  id             String               @id @default(cuid())
  organizationId String
  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workflowRunId  String
  workflowRun    WorkflowRun          @relation(fields: [workflowRunId], references: [id], onDelete: Cascade)
  order          Int
  actionType     ActionTypeEnum
  channel        Channel?
  status         WorkflowActionStatus
  policyOutcome  PolicyDecisionType
  offsetMinutes  Int
  reason         String

  @@index([workflowRunId])
  @@index([organizationId])
}

model WorkflowResult {
  id             String              @id @default(cuid())
  organizationId String
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workflowRunId  String              @unique
  workflowRun    WorkflowRun         @relation(fields: [workflowRunId], references: [id], onDelete: Cascade)
  outcome        WorkflowOutcomeType
  summary        String
  createdAt      DateTime            @default(now())

  @@index([organizationId])
}

model OutcomeEvent {
  id             String           @id @default(cuid())
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customerId     String
  customer       Customer         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  opportunityId  String?
  opportunity    Opportunity?     @relation(fields: [opportunityId], references: [id])
  workflowRunId  String?
  workflowRun    WorkflowRun?     @relation(fields: [workflowRunId], references: [id], onDelete: Cascade)
  outcomeType    OutcomeEventType
  outcomeReason  String
  confidence     Int
  actionType     ActionTypeEnum?
  occurredAt     DateTime         @default(now())

  @@index([customerId])
  @@index([opportunityId])
  @@index([workflowRunId])
  @@index([organizationId])
}

model RevenueAttribution {
  id                String          @id @default(cuid())
  organizationId    String
  organization      Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customerId        String
  customer          Customer        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  opportunityId     String?
  opportunity       Opportunity?    @relation(fields: [opportunityId], references: [id])
  workflowRunId     String?
  workflowRun       WorkflowRun?    @relation(fields: [workflowRunId], references: [id], onDelete: Cascade)
  attributedAmount  Int
  attributionType   AttributionType
  attributionReason String
  confidence        Int
  createdAt         DateTime        @default(now())

  @@index([customerId])
  @@index([opportunityId])
  @@index([attributionType])
  @@index([organizationId])
}

model StageTransition {
  id             String           @id @default(cuid())
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  opportunityId  String
  opportunity    Opportunity      @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  fromStage      OpportunityStage
  toStage        OpportunityStage
  reason         String
  triggeredBy    String
  createdAt      DateTime         @default(now())

  @@index([opportunityId])
  @@index([organizationId])
}

model WorkflowEffectivenessSnapshot {
  id                String       @id @default(cuid())
  organizationId    String
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workflowRunId     String       @unique
  workflowRun       WorkflowRun  @relation(fields: [workflowRunId], references: [id], onDelete: Cascade)
  completionStatus  String
  actionsExecuted   Int
  actionsBlocked    Int
  actionsEscalated  Int
  outcomeScore      Int
  revenueInfluenced Int
  policyFriction    Int
  createdAt         DateTime     @default(now())

  @@index([organizationId])
}

model MissedOpportunityEstimate {
  id                        String                    @id @default(cuid())
  organizationId            String
  organization              Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customerId                String
  customer                  Customer                  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  opportunityId             String?
  opportunity               Opportunity?              @relation(fields: [opportunityId], references: [id])
  estimatedValue            Int
  missedReason              String
  severity                  MissedOpportunitySeverity
  recommendedRecoveryAction String
  createdAt                 DateTime                  @default(now())

  @@index([customerId])
  @@index([severity])
  @@index([organizationId])
}

model AIRecommendation {
  id                  String                 @id @default(cuid())
  organizationId      String
  organization        Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customerId          String
  customer            Customer               @relation(fields: [customerId], references: [id], onDelete: Cascade)
  opportunityId       String?
  opportunity         Opportunity?           @relation(fields: [opportunityId], references: [id])
  recommendationType  String
  recommendationLabel String
  confidence          Int
  confidenceTier      String
  provider            String
  status              AIRecommendationStatus @default(generated)
  reviewState         AIReviewState          @default(pending_review)
  explanation         AIExplanation?
  reviewDecisions     AIReviewDecision[]
  createdAt           DateTime               @default(now())

  @@index([organizationId])
  @@index([customerId])
  @@index([reviewState])
  @@index([status])
}

model AIExplanation {
  id                 String           @id @default(cuid())
  organizationId     String
  organization       Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  recommendationId   String           @unique
  recommendation     AIRecommendation @relation(fields: [recommendationId], references: [id], onDelete: Cascade)
  explanation        String
  reasoningFactors   String[]
  supportingSignals  String[]
  riskConsiderations String[]
  createdAt          DateTime         @default(now())

  @@index([organizationId])
}

model AIReviewDecision {
  id               String               @id @default(cuid())
  organizationId   String
  organization     Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  recommendationId String
  recommendation   AIRecommendation     @relation(fields: [recommendationId], references: [id], onDelete: Cascade)
  reviewerId       String
  reviewerName     String
  decision         AIReviewDecisionType
  notes            String
  createdAt        DateTime             @default(now())

  @@index([organizationId])
  @@index([recommendationId])
}
